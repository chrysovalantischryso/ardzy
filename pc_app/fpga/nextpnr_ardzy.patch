+            continue;
+        int npar = (ci->type == id_RAMB36E1_RAMB36E1) ? 4 : 2;
+        for (auto ab : {std::make_pair(id_WRITE_WIDTH_A, "DIPADIP"), std::make_pair(id_WRITE_WIDTH_B, "DIPBDIP")}) {
