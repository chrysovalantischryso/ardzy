# Build output: SD card images, kernels, root file systems (published as GitHub Release files instead)
out/
*.img
*.img.xz
*.tar.gz

# The Windows app build (published as a Release zip)
pc_app/dist/
build/

# Big prebuilt tools bundled into the app (yosys/nextpnr toolchain, Icarus Verilog).
# Get them from the Windows release zip, or build them: pc_app/fpga/make_toolchain.sh
pc_app/tools/

# The app's workspace: only the built-in example projects are part of the repository
# (ardzy_io = the pin-control design the board loads at power-on). Your own projects stay private.
projects/*
!projects/ardzy_io/
!projects/blink/
!projects/board_hello/
!projects/fpga_ramtest/
!projects/fpga_selftest/
!projects/leds_python/

# Not ours to share: the boot file from the original Bitmain SD card, and the annotated board photo
# used by the Map view's Photo mode (from a third-party pin map; the app works without it)
fallback/BOOT_fallback.bin
pc_app/ui/img/board_top.jpg

# Generated by the simulation tests
fpga_projects/*/sim/tb.v
*.vvp
*.vcd

# Vivado leftovers
.Xil/
*.jou
*.log
*.runs/
*.cache/

# Python / editors / OS
__pycache__/
*.pyc
.venv/
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
