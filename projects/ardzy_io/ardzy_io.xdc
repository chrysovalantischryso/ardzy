set_property -dict {PACKAGE_PIN M15 IOSTANDARD LVCMOS33} [get_ports {pins[41]}] ;# board_id[0]
set_property -dict {PACKAGE_PIN M14 IOSTANDARD LVCMOS33} [get_ports {pins[42]}] ;# board_id[1]
set_property -dict {PACKAGE_PIN L15 IOSTANDARD LVCMOS33} [get_ports {pins[43]}] ;# board_id[2]
set_property -dict {PACKAGE_PIN L14 IOSTANDARD LVCMOS33} [get_ports {pins[44]}] ;# board_id[3]
set_property -dict {PACKAGE_PIN W18 IOSTANDARD LVCMOS33} [get_ports {pins[45]}] ;# i2c1_scl
set_property -dict {PACKAGE_PIN W19 IOSTANDARD LVCMOS33} [get_ports {pins[46]}] ;# i2c1_sda
set_property -dict {PACKAGE_PIN N17 IOSTANDARD LVCMOS33} [get_ports {pins[47]}] ;# i2c2_scl
set_property -dict {PACKAGE_PIN P18 IOSTANDARD LVCMOS33} [get_ports {pins[48]}] ;# i2c2_sda
# the 36 connector pins float when nothing is plugged in: weak pull-ups
set_property PULLTYPE PULLUP [get_ports {pins[0]}]
set_property PULLTYPE PULLUP [get_ports {pins[1]}]
set_property PULLTYPE PULLUP [get_ports {pins[2]}]
set_property PULLTYPE PULLUP [get_ports {pins[3]}]
set_property PULLTYPE PULLUP [get_ports {pins[4]}]
