# Extra kernel options on top of xilinx_zynq_defconfig
# --- systemd (Debian 13) ---
CONFIG_CGROUPS=y
CONFIG_CGROUP_BPF=y
CONFIG_BPF_SYSCALL=y
CONFIG_MEMCG=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EPOLL=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_NAMESPACES=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y
CONFIG_IPV6=y
CONFIG_UNIX=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# --- FPGA: load designs + overlays at runtime ---
CONFIG_FPGA=y
CONFIG_FPGA_MGR_ZYNQ_FPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
CONFIG_OF_OVERLAY=y
CONFIG_OF_CONFIGFS=y
CONFIG_CONFIGFS_FS=y
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
CONFIG_UIO_DMEM_GENIRQ=y
CONFIG_GPIO_XILINX=y
CONFIG_XILINX_DMA=y
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
# --- CPU speed control: OFF. cpufreq-dt panicked at boot in testing (the clock driver refuses
#     to change the CPU clock: -EBUSY, and cpufreq_online() then hits BUG()). Keep it off. ---
# CONFIG_CPUFREQ_DT is not set
# --- NAND flash (read-only partition in the device tree) ---
CONFIG_MTD=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_RAW_NAND=y
CONFIG_MTD_NAND_PL35X=y
CONFIG_PL353_SMC=y
# --- board ---
CONFIG_CADENCE_WATCHDOG=y
CONFIG_WATCHDOG=y
CONFIG_I2C_CADENCE=y
CONFIG_I2C_CHARDEV=y
CONFIG_SPI_SPIDEV=m
CONFIG_SPI_XILINX=m
CONFIG_SPI_CADENCE=y
CONFIG_GPIO_SYSFS=y
CONFIG_IIO=m
CONFIG_XILINX_XADC=m
CONFIG_SND_SOC=m
# --- USB gadgets / misc tools ---
CONFIG_USB_SERIAL=m
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
# --- version name: plain 6.18.0-xilinx-s9 (no git hash / -dirty suffix) ---
# CONFIG_LOCALVERSION_AUTO is not set

# Ardzy 0.2: compressed swap in RAM (zram), so big sketches and libraries compile in 512 MB
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_LZO=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_DEF_COMP_LZ4=y
