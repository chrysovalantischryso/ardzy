# ardzy_io.xdc - generated by scripts/make_pins.py: the 49 FPGA pins of ardzy_ctl (pins[i]),
# index = AXI GPIO channel 1 bit (0..31) or 32 + channel 2 bit, the fan PWM and the 6 fan speed inputs
set_property -dict {PACKAGE_PIN T11 IOSTANDARD LVCMOS33} [get_ports {pins[0]}] ;# j1[0]
set_property -dict {PACKAGE_PIN T12 IOSTANDARD LVCMOS33} [get_ports {pins[1]}] ;# j1[1]
set_property -dict {PACKAGE_PIN U12 IOSTANDARD LVCMOS33} [get_ports {pins[2]}] ;# j1[2]
set_property -dict {PACKAGE_PIN T10 IOSTANDARD LVCMOS33} [get_ports {pins[3]}] ;# j1[3]
set_property -dict {PACKAGE_PIN R19 IOSTANDARD LVCMOS33} [get_ports {pins[4]}] ;# j2[0]
set_property -dict {PACKAGE_PIN V12 IOSTANDARD LVCMOS33} [get_ports {pins[5]}] ;# j2[1]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33} [get_ports {pins[6]}] ;# j2[2]
set_property -dict {PACKAGE_PIN V13 IOSTANDARD LVCMOS33} [get_ports {pins[7]}] ;# j2[3]
set_property -dict {PACKAGE_PIN T14 IOSTANDARD LVCMOS33} [get_ports {pins[8]}] ;# j3[0]
set_property -dict {PACKAGE_PIN P14 IOSTANDARD LVCMOS33} [get_ports {pins[9]}] ;# j3[1]
set_property -dict {PACKAGE_PIN R14 IOSTANDARD LVCMOS33} [get_ports {pins[10]}] ;# j3[2]
set_property -dict {PACKAGE_PIN T15 IOSTANDARD LVCMOS33} [get_ports {pins[11]}] ;# j3[3]
set_property -dict {PACKAGE_PIN Y16 IOSTANDARD LVCMOS33} [get_ports {pins[12]}] ;# j4[0]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33} [get_ports {pins[13]}] ;# j4[1]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33} [get_ports {pins[14]}] ;# j4[2]
set_property -dict {PACKAGE_PIN Y17 IOSTANDARD LVCMOS33} [get_ports {pins[15]}] ;# j4[3]
set_property -dict {PACKAGE_PIN T16 IOSTANDARD LVCMOS33} [get_ports {pins[16]}] ;# j5[0]
set_property -dict {PACKAGE_PIN V15 IOSTANDARD LVCMOS33} [get_ports {pins[17]}] ;# j5[1]
set_property -dict {PACKAGE_PIN W15 IOSTANDARD LVCMOS33} [get_ports {pins[18]}] ;# j5[2]
set_property -dict {PACKAGE_PIN U17 IOSTANDARD LVCMOS33} [get_ports {pins[19]}] ;# j5[3]
set_property -dict {PACKAGE_PIN U14 IOSTANDARD LVCMOS33} [get_ports {pins[20]}] ;# j6[0]
set_property -dict {PACKAGE_PIN U18 IOSTANDARD LVCMOS33} [get_ports {pins[21]}] ;# j6[1]
set_property -dict {PACKAGE_PIN U19 IOSTANDARD LVCMOS33} [get_ports {pins[22]}] ;# j6[2]
set_property -dict {PACKAGE_PIN U15 IOSTANDARD LVCMOS33} [get_ports {pins[23]}] ;# j6[3]
set_property -dict {PACKAGE_PIN T20 IOSTANDARD LVCMOS33} [get_ports {pins[24]}] ;# j7[0]
set_property -dict {PACKAGE_PIN V20 IOSTANDARD LVCMOS33} [get_ports {pins[25]}] ;# j7[1]
set_property -dict {PACKAGE_PIN W20 IOSTANDARD LVCMOS33} [get_ports {pins[26]}] ;# j7[2]
set_property -dict {PACKAGE_PIN U20 IOSTANDARD LVCMOS33} [get_ports {pins[27]}] ;# j7[3]
set_property -dict {PACKAGE_PIN Y18 IOSTANDARD LVCMOS33} [get_ports {pins[28]}] ;# j8[0]
set_property -dict {PACKAGE_PIN V16 IOSTANDARD LVCMOS33} [get_ports {pins[29]}] ;# j8[1]
set_property -dict {PACKAGE_PIN W16 IOSTANDARD LVCMOS33} [get_ports {pins[30]}] ;# j8[2]
set_property -dict {PACKAGE_PIN Y19 IOSTANDARD LVCMOS33} [get_ports {pins[31]}] ;# j8[3]
set_property -dict {PACKAGE_PIN R16 IOSTANDARD LVCMOS33} [get_ports {pins[32]}] ;# j9[0]
set_property -dict {PACKAGE_PIN T17 IOSTANDARD LVCMOS33} [get_ports {pins[33]}] ;# j9[1]
set_property -dict {PACKAGE_PIN R18 IOSTANDARD LVCMOS33} [get_ports {pins[34]}] ;# j9[2]
set_property -dict {PACKAGE_PIN R17 IOSTANDARD LVCMOS33} [get_ports {pins[35]}] ;# j9[3]
set_property -dict {PACKAGE_PIN F16 IOSTANDARD LVCMOS33} [get_ports {pins[36]}] ;# leds[0]
set_property -dict {PACKAGE_PIN L19 IOSTANDARD LVCMOS33} [get_ports {pins[37]}] ;# leds[1]
