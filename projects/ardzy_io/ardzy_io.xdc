set_property -dict {PACKAGE_PIN J18 IOSTANDARD LVCMOS33} [get_ports fan_pwm]
set_property -dict {PACKAGE_PIN F19 IOSTANDARD LVCMOS33} [get_ports {fan_tach[0]}]
